# Configurações da aplicação
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Banco de dados
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost/restaurant_db

# Environment (development, staging, production)
# development: Logging detalhado no console e arquivo
# production: Logging otimizado apenas para arquivo
ENVIRONMENT=development

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]

# Database para testes
TEST_DATABASE_URL=postgresql+asyncpg://postgres:password@localhost/restaurant_test_db

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-s3-bucket-name
S3_ENDPOINT_URL=  # Optional: For MinIO or other S3-compatible services

# Email Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=your-email@gmail.com
FRONTEND_URL=http://localhost:3000
