# Configurações da aplicação
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Banco de dados
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost/restaurant_db

# Environment (development, staging, production)
# development: Logging detalhado no console e arquivo
# production: Logging otimizado apenas para arquivo
ENVIRONMENT=development

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]

# Database para testes
TEST_DATABASE_URL=postgresql+asyncpg://postgres:password@localhost/restaurant_test_db
